# Database Configuration
# PostgreSQL connection string for the main database
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/sindh_archives

# Table Names - Customize these if you want different table names
USERS_TABLE_NAME=users
COMMISSIONER_TABLE_NAME=commissioner_records
COURT_TABLE_NAME=court_records

# Database Connection Pool Settings
# Minimum number of connections to maintain in the pool
DB_MIN_CONNECTIONS=2
# Maximum number of connections allowed in the pool
DB_MAX_CONNECTIONS=10

# Security Settings
# Secret key for JWT token signing - CHANGE THIS IN PRODUCTION!
JWT_SECRET=change-this-default-secret-key-in-production
# Algorithm used for JWT tokens
JWT_ALGORITHM=HS256
# JWT token expiration in hours
JWT_EXPIRATION_HOURS=24
# Number of rounds for bcrypt password hashing (higher = more secure but slower)
BCRYPT_ROUNDS=12

# Initial Admin User (used by init_db.py script)
# Email for the initial admin user account
INITIAL_ADMIN_EMAIL=admin@sindh-archives.org
# Password for the initial admin user account (will be hashed)
INITIAL_ADMIN_PASSWORD=SecurePassword123!

# Application Settings
APP_NAME=Sindh Archives Backend
APP_VERSION=0.1.0
# Set to "True" to enable debug mode
DEBUG=False
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO